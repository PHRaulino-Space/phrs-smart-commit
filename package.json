{
  "name": "phrs-smart-commit",
  "displayName": "PHRS Smart Commit",
  "description": "Generate smart commit messages with the AI CLI of your choice (Claude, Gemini, Codex, or a local model via Ollama)",
  "version": "1.2.0",
  "publisher": "PHRaulino",
  "author": {
    "name": "PHRaulino"
  },
  "license": "MIT",
  "homepage": "https://github.com/PHRaulino-Space/phrs-smart-commit#readme",
  "bugs": {
    "url": "https://github.com/PHRaulino-Space/phrs-smart-commit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PHRaulino-Space/phrs-smart-commit"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "claude",
    "anthropic",
    "gemini",
    "codex",
    "openai",
    "ollama",
    "local-llm",
    "commit-message",
    "automation"
  ],
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "icon": "icon.png",
  "activationEvents": [],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Reads the CLI path from settings and executes it. Workspace-scoped overrides of phrs-smart-commit.binaryPath could be abused to run arbitrary binaries."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "phrs-smart-commit.createCommitMessage",
        "title": "Create Commit Message",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "phrs-smart-commit.createCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "scm/resourceGroup/inline": [
        {
          "command": "phrs-smart-commit.createCommitMessage",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "PHRS Smart Commit",
      "properties": {
        "phrs-smart-commit.provider": {
          "type": "string",
          "default": "claude",
          "enum": [
            "claude",
            "gemini",
            "codex",
            "ollama"
          ],
          "enumDescriptions": [
            "Anthropic Claude Code CLI (claude)",
            "Google Gemini CLI (gemini)",
            "OpenAI Codex CLI (codex)",
            "Local model via Ollama (ollama)"
          ],
          "description": "Which AI CLI is used to generate the commit message. The matching CLI must be installed and authenticated."
        },
        "phrs-smart-commit.model": {
          "type": "string",
          "default": "",
          "description": "Model passed to the selected CLI. Leave empty to use the provider default (claude: sonnet, gemini: gemini-2.5-flash, codex: gpt-5-codex, ollama: llama3)."
        },
        "phrs-smart-commit.language": {
          "type": "string",
          "default": "en-us",
          "enum": [
            "pt-br",
            "en-us",
            "es",
            "fr",
            "de",
            "it",
            "ja",
            "zh-cn"
          ],
          "enumDescriptions": [
            "Brazilian Portuguese",
            "English",
            "Spanish",
            "French",
            "German",
            "Italian",
            "Japanese",
            "Simplified Chinese"
          ],
          "description": "Language for the generated commit message. Conventional commit type keywords (feat, fix, etc.) always stay in English."
        },
        "phrs-smart-commit.binaryPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Custom path to the selected CLI executable (optional - auto-detects from PATH by default). Workspace overrides are ignored in untrusted workspaces."
        },
        "phrs-smart-commit.maxDiffBytes": {
          "type": "number",
          "default": 102400,
          "minimum": 1024,
          "description": "Maximum diff size (in bytes) sent to the CLI. Above this you are asked to generate from a summary (git diff --stat) or cancel and split into smaller commits. Lockfiles and generated artifacts (*.lock, *.min.js, *.map, etc.) are excluded from the diff automatically."
        },
        "phrs-smart-commit.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug mode to show CLI commands being executed"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.21",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2"
  }
}
